{
  "schema_version": 1,
  "benchmark_id": "critic-model-select-v1-package",
  "purpose": "Reusable static package for single-round serial Critic review of two blind candidate inputs.",
  "source_protocol": "critic-model-select-v1",
  "public_candidate_files": [
    "TASKS.md",
    "public_smoke_tests.py",
    "dependency_layers.py"
  ],
  "scoring_dimensions": {
    "recall": {
      "max_points": 50,
      "breakdown": {
        "GT1": 30,
        "GT2": 10,
        "GT3": 10
      }
    },
    "precision": {
      "max_points": 20
    },
    "depth": {
      "max_points": 15
    },
    "speed": {
      "max_points": 10
    },
    "format": {
      "max_points": 5
    }
  },
  "execution": {
    "rounds_per_model": 1,
    "cells_per_model": 2,
    "candidate_order": [
      "candidate-A",
      "candidate-B"
    ],
    "dispatch": "strictly_serial",
    "wall_clock_source": "agent_task_metadata.started_at_to_ended_at",
    "token_usage": "unavailable_and_not_scored",
    "new_runs": "must_be_written_outside_this_package"
  },
  "controller_assets": [
    "scoring/",
    "evaluator/"
  ],
  "excluded_assets": [
    "reviews/*.json",
    "score-summary.json",
    "timing-events.json",
    "old leaderboards",
    "historical workspaces",
    "provider failure logs",
    "__pycache__/",
    "*.pyc",
    ".pytest_cache/",
    "subtest_15 short A17/B17 results"
  ],
